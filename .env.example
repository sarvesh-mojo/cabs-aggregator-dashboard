# Analytics / ops API host (viaVIP_API or mojo-management-backend).
# Aggregator JWT is used when host is empty or same-origin; set this when
# calling viaVIP / management analytics endpoints from imported pages.
VITE_domain=http://127.0.0.1:3000

# Optional Mojo event / spicescreen hosts (imported management pages)
VITE_MOJO_domain=
VITE_MOJO_EVENT_PREPROD_domain=

# Aggregator admin/auth uses Vite proxy → http://127.0.0.1:4100
# Override only if the dashboard is not served with that proxy:
# VITE_API_BASE=

# Set to false to disable fallback to management /users/login
VITE_USE_LEGACY_LOGIN=false
VITE_USE_READ_API=false
