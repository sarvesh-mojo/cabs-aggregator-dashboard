# --- Local (npm run dev → http://localhost:5174) ---
# Aggregator login/config: Vite proxies /auth /admin /v1 → http://127.0.0.1:4100
# Leave VITE_API_BASE empty locally.
VITE_API_BASE=
VITE_domain=http://127.0.0.1:3002

# --- Dev host (aggregator-dashboard.bookairportcab.com) ---
# Build/redeploy with these instead of the local values above:
# VITE_API_BASE=https://api-aggregator.bookairportcab.com
# VITE_domain=https://viavip-devapi.bookairportcab.com

VITE_MOJO_domain=
VITE_MOJO_EVENT_PREPROD_domain=

VITE_USE_LEGACY_LOGIN=false
VITE_USE_READ_API=false
